diff --git a/cmake/riff_checkpoint_sha.cmake b/cmake/riff_checkpoint_sha.cmake
new file mode 100644
index 0000000..3e9d10e
--- /dev/null
+++ b/cmake/riff_checkpoint_sha.cmake
@@ -0,0 +1,23 @@
+# System SHA is optional; never download, bundle or select a static libcrypto.
+option(RIFF_CHECKPOINT_SYSTEM_SHA "Discover the platform system SHA-256 library" ON)
+add_library(riff_checkpoint_sha INTERFACE)
+set(backend portable)
+if(RIFF_CHECKPOINT_SYSTEM_SHA)
+    if(APPLE)
+        set(backend commoncrypto)
+    elseif(CMAKE_SYSTEM_NAME STREQUAL "Linux")
+        set(OPENSSL_USE_STATIC_LIBS FALSE)
+        find_package(OpenSSL QUIET COMPONENTS Crypto)
+        if(OpenSSL_FOUND AND TARGET OpenSSL::Crypto AND
+           NOT OPENSSL_CRYPTO_LIBRARY MATCHES "\\.a$")
+            set(backend openssl-evp)
+            target_compile_definitions(riff_checkpoint_sha INTERFACE RIFF_CHECKPOINT_OPENSSL_SHA=1)
+            target_link_libraries(riff_checkpoint_sha INTERFACE OpenSSL::Crypto)
+        endif()
+    endif()
+endif()
+if(backend STREQUAL "portable")
+    target_compile_definitions(riff_checkpoint_sha INTERFACE RIFF_CHECKPOINT_PORTABLE_SHA=1)
+endif()
+set(RIFF_CHECKPOINT_SHA_BACKEND "${backend}" CACHE INTERNAL "Selected SHA-256 implementation" FORCE)
+message(STATUS "Riff checkpoint SHA-256: ${backend}")
