+// The 128-wide F16 acoustic attention case fits 16 queries in 20 KiB of
+// threadgroup memory. Keep the original tile for short queries; its scheduling is faster.
+int ggml_metal_op_flash_attn_ext_query_tile(const ggml_tensor * op) {
+    const bool wide = op->src[3] == nullptr && op->src[0]->ne[1] >= 4096 &&
+        op->src[1]->type == GGML_TYPE_F16 && op->src[2]->type == GGML_TYPE_F16 &&
+        op->src[1]->ne[0] == 128 && op->src[2]->ne[0] == 128;
+    return wide && getenv("GGML_METAL_WIDE_ATTENTION_DISABLE") == nullptr ? 16 : OP_FLASH_ATTN_EXT_NQPSG;
+}
