+void skip_json_space(const char *& cursor, const char * end) {
+    while (cursor < end && (*cursor == ' ' || *cursor == '\t' || *cursor == '\r' || *cursor == '\n')) ++cursor;
+}
+
+using JsonOwner = std::unique_ptr<cJSON, decltype(&cJSON_Delete)>;
+
+JsonOwner consume_json_value(const char *& cursor, const char * end) {
+    const char * after = nullptr;
+    JsonOwner value(cJSON_ParseWithLengthOpts(cursor, static_cast<size_t>(end - cursor), &after, 0), &cJSON_Delete);
+    if (!value || after == nullptr || after <= cursor || after > end) {
+        throw std::runtime_error("Yue2 score_tokens_file has invalid JSON content");
+    }
+    cursor = after;
+    return value;
+}
+
+std::string full_json_key(const char * begin, const char * end, const cJSON & decoded) {
+    auto invalid = [] { throw std::runtime_error("Yue2 score_tokens_file has an invalid field name"); };
+    if (!cJSON_IsString(&decoded) || decoded.valuestring == nullptr || end - begin < 2 ||
+        *begin != '"' || end[-1] != '"') invalid();
+    // cJSON has already decoded every byte, including bytes after \u0000,
+    // but exposes only a C string. Recover its full UTF-8 length from the
+    // validated source spelling; retain cJSON's decoder rather than adding
+    // another JSON or Unicode decoder. Never use strlen/strcmp for key identity.
+    const char * cursor = begin + 1;
+    const char * limit = end - 1;
+    size_t size = 0;
+    auto hex_quad = [&]() {
+        if (limit - cursor < 4) invalid();
+        uint32_t value = 0;
+        for (int i = 0; i < 4; ++i) {
+            const char digit = *cursor++;
+            value <<= 4;
+            if (digit >= '0' && digit <= '9') value += digit - '0';
+            else if (digit >= 'a' && digit <= 'f') value += digit - 'a' + 10;
+            else if (digit >= 'A' && digit <= 'F') value += digit - 'A' + 10;
+            else invalid();
+        }
+        return value;
+    };
+    while (cursor < limit) {
+        const unsigned char byte = static_cast<unsigned char>(*cursor++);
+        if (byte < 0x20 || byte == '"') invalid();
+        if (byte != '\\') { ++size; continue; }
+        if (cursor == limit) invalid();
+        switch (*cursor++) {
+        case '"': case '\\': case '/': case 'b': case 'f': case 'n': case 'r': case 't':
+            ++size;
+            break;
+        case 'u': {
+            const auto first = hex_quad();
+            if (first >= 0xD800 && first <= 0xDBFF) {
+                if (limit - cursor < 6 || cursor[0] != '\\' || cursor[1] != 'u') invalid();
+                cursor += 2;
+                const auto second = hex_quad();
+                if (second < 0xDC00 || second > 0xDFFF) invalid();
+                size += 4;
+            } else {
+                if (first >= 0xDC00 && first <= 0xDFFF) invalid();
+                size += first < 0x80 ? 1 : first < 0x800 ? 2 : 3;
+            }
+            break;
+        }
+        default:
+            invalid();
+        }
+    }
+    return std::string(decoded.valuestring, size);
+}
+
+std::vector<int32_t> exact_integer_score_array(const char *& cursor, const char * end) {
+    auto invalid = [] {
+        throw std::runtime_error("Yue2 score_tokens_file IDs must be decimal JSON integers in [0,151643)");
+    };
+    if (cursor == end || *cursor++ != '[') invalid();
+    skip_json_space(cursor, end);
+    std::vector<int32_t> out;
+    if (cursor < end && *cursor == ']') { ++cursor; return out; }
+    while (cursor < end) {
+        const char * begin = cursor;
+        if (*cursor == '-') ++cursor;
+        if (cursor == end) invalid();
+        if (*cursor == '0') {
+            ++cursor;
+        } else if (*cursor >= '1' && *cursor <= '9') {
+            do { ++cursor; } while (cursor < end && *cursor >= '0' && *cursor <= '9');
+        } else {
+            invalid();
+        }
+        const char * number_end = cursor;
+        int32_t id = 0;
+        const auto parsed = std::from_chars(begin, number_end, id);
+        if (parsed.ec != std::errc{} || parsed.ptr != number_end || id < 0 || id >= kEodToken) invalid();
+        skip_json_space(cursor, end);
+        // Decimal points, exponent markers and leading-zero continuations
+        // are rejected before any floating conversion could erase them.
+        if (cursor == end || (*cursor != ',' && *cursor != ']')) invalid();
+        out.push_back(id);
+        if (*cursor++ == ']') return out;
+        skip_json_space(cursor, end);
+    }
+    invalid();
+    return {}; // invalid() always throws.
+}
+
+Yue2ScoreTokens exact_score_fields(const std::string & text) {
+    // The complete document was already structurally parsed. Resolve all
+    // top-level fields by their full decoded identity before selecting score
+    // data. Unrelated metadata still uses the existing cJSON value parser.
+    // Both traversals are linear; score IDs come from their original lexemes.
+    const char * cursor = text.data();
+    const char * end = cursor + text.size();
+    Yue2ScoreTokens out;
+    bool has_tokens = false;
+    std::unordered_set<std::string> fields;
+    skip_json_space(cursor, end);
+    if (cursor == end || *cursor++ != '{') throw std::runtime_error("Yue2 score_tokens_file must be an object");
+    skip_json_space(cursor, end);
+    while (cursor < end && *cursor != '}') {
+        const char * begin = cursor;
+        auto parsed_key = consume_json_value(cursor, end);
+        auto key = full_json_key(begin, cursor, *parsed_key);
+        if (!fields.emplace(key).second) throw std::runtime_error("Yue2 score_tokens_file has duplicate fields");
+        skip_json_space(cursor, end);
+        if (cursor == end || *cursor++ != ':') throw std::runtime_error("Yue2 score_tokens_file has an invalid field");
+        skip_json_space(cursor, end);
+        if (key == "tokens") {
+            out.ids = exact_integer_score_array(cursor, end);
+            has_tokens = true;
+        } else {
+            auto value = consume_json_value(cursor, end);
+            if (key == "truncated") {
+                if (!cJSON_IsBool(value.get())) throw std::runtime_error("Yue2 score_tokens_file truncated must be a boolean");
+                out.truncated = cJSON_IsTrue(value.get());
+            }
+        }
+        skip_json_space(cursor, end);
+        if (cursor == end || *cursor != ',') break;
+        ++cursor;
+        skip_json_space(cursor, end);
+    }
+    if (!has_tokens) throw std::runtime_error("Yue2 score_tokens_file requires a tokens array");
+    return out;
+}
+
+Yue2ScoreTokens score_tokens_from_file(const std::filesystem::path & path) {
+    if (!engine::io::is_existing_file(path)) {
+        throw std::runtime_error("Yue2 score_tokens_file does not exist: " + path.string());
+    }
+    const auto text = engine::io::read_text_file(path);
+    const char * end = nullptr;
+    std::unique_ptr<cJSON, decltype(&cJSON_Delete)> root(
+        cJSON_ParseWithLengthOpts(text.data(), text.size(), &end, 0), &cJSON_Delete);
+    if (!root || !cJSON_IsObject(root.get())) {
+        throw std::runtime_error("Yue2 score_tokens_file must contain a JSON object");
+    }
+    for (const char * cursor = end; cursor < text.data() + text.size(); ++cursor) {
+        if (std::isspace(static_cast<unsigned char>(*cursor)) == 0) {
+            throw std::runtime_error("Yue2 score_tokens_file has trailing JSON content");
+        }
+    }
+    // Its C-string keys and rounded numeric values cannot establish full key
+    // identity or exact integer IDs. Release the structural tree before the
+    // field traversal, then resolve those two small contracts from source bytes.
+    root.reset();
+    return exact_score_fields(text);
+}
