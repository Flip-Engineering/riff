+void validate_yue2_score_input(const Yue2Request & request) {
+    if (!request.score_tokens.has_value()) return;
+    if (!request.abc.empty()) {
+        throw std::runtime_error("Yue2 exact score tokens cannot be combined with ABC text");
+    }
