+#pragma once
+
+#include <cmath>
+#include <cstdint>
+#include <stdexcept>
+#include <string>
+#include <utility>
+#include <vector>
+
+namespace engine::models::yue2 {
+
+enum class Yue2OdeMethod { Midpoint, AdamsBashforth2 };
+
+inline Yue2OdeMethod parse_ode_method(const std::string & value) {
+    if (value == "midpoint") return Yue2OdeMethod::Midpoint;
+    if (value == "ab2") return Yue2OdeMethod::AdamsBashforth2;
+    throw std::invalid_argument("Yue2 ode_method must be midpoint or ab2");
+}
+
+// Integrate dx/dt = velocity(x,t) from noise at t=1 to audio latents at t=0.
+// AB2 keeps second-order accuracy with one evaluation per step after a
+// midpoint startup. It has a different stability region from midpoint.
+// Every chunk starts its own history; velocity may contain a full neural model.
+template <typename Velocity, typename Progress>
+std::vector<float> integrate_flow(
+    std::vector<float> state,
+    int64_t steps,
+    Yue2OdeMethod method,
+    Velocity && velocity,
+    Progress && progress) {
+    if (steps < 1) throw std::invalid_argument("Yue2 solver steps must be positive");
+    if (method != Yue2OdeMethod::Midpoint && method != Yue2OdeMethod::AdamsBashforth2) {
+        throw std::invalid_argument("Unknown Yue2 acoustic solver");
+    }
+    const float dt = 1.0F / static_cast<float>(steps);
+    std::vector<float> previous;
+    std::vector<float> mid(state.size());
+    auto evaluate = [&](const std::vector<float> & input, float t) {
+        auto result = velocity(input, t);
+        if (result.size() != state.size()) {
+            throw std::runtime_error("Yue2 acoustic velocity shape mismatch");
+        }
+        return result;
+    };
+    for (int64_t step = 0; step < steps; ++step) {
+        const float t = 1.0F - static_cast<float>(step) * dt;
+        auto first = evaluate(state, t);
+        if (method == Yue2OdeMethod::AdamsBashforth2 && !previous.empty()) {
+            for (size_t i = 0; i < state.size(); ++i) {
+                state[i] -= (1.5F * first[i] - 0.5F * previous[i]) * dt;
+            }
+        } else {
+            for (size_t i = 0; i < state.size(); ++i) {
+                mid[i] = state[i] - first[i] * (dt / 2.0F);
+            }
+            const auto second = evaluate(mid, t - dt / 2.0F);
+            for (size_t i = 0; i < state.size(); ++i) state[i] -= second[i] * dt;
+        }
+        for (float value : state) {
+            if (!std::isfinite(value)) {
+                throw std::runtime_error("Yue2 acoustic solver diverged; increase steps or use midpoint");
+            }
+        }
+        if (method == Yue2OdeMethod::AdamsBashforth2) previous = std::move(first);
+        progress(step + 1);
+    }
+    return state;
+}
+
+}  // namespace engine::models::yue2
