+// Persistent job mode (--jobs -). The session, and any model weights it keeps
+// resident, outlives individual requests. Each stdin line is one JSON job:
+// build_request_from_json fields plus "id" (required), "out" (audio path) and
+// "metrics" (bool). Output between the begin/end markers is that job's normal
+// log, result and metrics text. Markers are single lines flushed immediately.
+bool valid_job_id(const std::string & id) {
+    if (id.empty() || id.size() > 128) {
+        return false;
+    }
+    return std::all_of(id.begin(), id.end(), [](unsigned char c) {
+        return std::isalnum(c) != 0 || c == '.' || c == '_' || c == ':' || c == '-';
+    });
+}
+
+std::string single_line(std::string text) {
+    for (char & c : text) {
+        if (c == '\n' || c == '\r') {
+            c = ' ';
+        }
+    }
+    return text;
+}
+
+// A failed backend computation can leave device state a later job must not
+// inherit. The caller restarts the process instead of continuing.
+bool backend_unrecoverable(const std::string & message) {
+    return message.find("compute failed") != std::string::npos;
+}
+
+int run_job_stream(
+    std::istream & input,
+    engine::runtime::IVoiceTaskSession & session,
+    engine::runtime::IOfflineVoiceTaskSession & offline,
+    const engine::runtime::TaskRequest & defaults,
+    bool metrics_default) {
+    std::cout << "@@riff-engine-ready riff.jobs.v1" << std::endl;
+    std::string line;
+    while (std::getline(input, line)) {
+        if (!line.empty() && line.back() == '\r') {
+            line.pop_back();
+        }
+        if (line.find_first_not_of(" \t") == std::string::npos) {
+            continue;
+        }
+        std::string id = "-";
+        bool begun = false;
+        try {
+            const auto job = engine::io::json::parse(line);
+            if (!job.is_object()) {
+                throw std::runtime_error("a job must be a JSON object");
+            }
+            const auto job_id = minitts::cli::json_optional_string(job, "id");
+            if (!job_id.has_value() || !valid_job_id(*job_id)) {
+                throw std::runtime_error("a job id must be 1-128 characters from [A-Za-z0-9._:-]");
+            }
+            id = *job_id;
+            std::cout << "@@riff-job-begin " << id << std::endl;
+            begun = true;
+            const auto out = minitts::cli::json_optional_string(job, "out");
+            bool metrics = metrics_default;
+            if (const auto * value = job.find("metrics"); value != nullptr && !value->is_null()) {
+                metrics = value->as_bool();
+            }
+            auto request = minitts::cli::build_request_from_json(job, std::filesystem::current_path());
+            for (const auto & [key, value] : defaults.options) {
+                request.options.emplace(key, value);
+            }
+            const auto start = std::chrono::steady_clock::now();
+            session.prepare(engine::runtime::build_preparation_request(request));
+            const auto result = offline.run(request);
+            const double wall_ms = duration_ms(std::chrono::steady_clock::now() - start);
+            std::cout << "family=" << session.family() << "\n";
+            std::cout << "task=" << engine::runtime::to_string(session.task_kind()) << "\n";
+            std::cout << "mode=" << engine::runtime::to_string(session.run_mode()) << "\n";
+            minitts::app::emit_task_result(
+                result,
+                out.has_value() ? std::optional<std::filesystem::path>(*out) : std::nullopt,
+                std::nullopt,
+                std::nullopt,
+                std::nullopt,
+                std::nullopt,
+                std::nullopt);
+            if (metrics) {
+                minitts::app::emit_task_metrics(result, audio_metrics_info(request), wall_ms);
+            }
+            std::cout << "@@riff-job-end " << id << " status=ok" << std::endl;
+        } catch (const std::exception & ex) {
+            const auto message = single_line(ex.what());
+            const bool fatal = backend_unrecoverable(message);
+            if (!begun) {
+                std::cout << "@@riff-job-begin " << id << "\n";
+            }
+            std::cout << "audiocpp_cli failed: " << message << "\n";
+            std::cout << "@@riff-job-end " << id << " status=error" << (fatal ? " fatal=1" : "")
+                      << " message=" << message << std::endl;
+            if (fatal) {
+                return 3;
+            }
+        }
+    }
+    return 0;
+}
+
