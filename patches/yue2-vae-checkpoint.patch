+}
+Digest hash_i32(const std::vector<int32_t> & values) {
+    Sha256 hash;
+    if (little_endian()) hash.update(values.data(),values.size()*sizeof(int32_t));
+    else for (auto value:values) { uint8_t bytes[4];put(bytes,uint32_t(value),4);hash.update(bytes,4); }
+    return hash.finish();
