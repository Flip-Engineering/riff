+Completed load_completed(const std::filesystem::path & path) {
+    auto file=open_read(path);const auto before=descriptor_identity(file.get());
+    Header header{};
+    if (std::fread(header.data(),1,header.size(),file.get())!=header.size()) fail("checkpoint header is incomplete");
+    Completed out;out.metadata=decode(header);
+    const auto bytes=payload_size(out.metadata);
+    if (before.bytes!=kHeaderBytes+bytes) fail("checkpoint payload is truncated or has trailing data");
+    out.latents.resize(static_cast<size_t>(bytes/4));
+    Sha256 hash;
+    for (size_t start=0;start<out.latents.size();) {
+        const auto n=std::min<size_t>(4096,out.latents.size()-start);
+        auto * values=out.latents.data()+start;
+        if (std::fread(values,4,n,file.get())!=n) fail("checkpoint payload ended early");
+        hash.update(values,n*4);
+        for (size_t i=0;i<n;++i) {
+            if (!little_endian()) { const uint32_t bits=static_cast<uint32_t>(get(reinterpret_cast<uint8_t *>(values+i),4));std::memcpy(values+i,&bits,4); }
