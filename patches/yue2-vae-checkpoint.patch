+    uint32_t size=0;_NSGetExecutablePath(nullptr,&size);std::vector<char> buffer(size);
+    if (_NSGetExecutablePath(buffer.data(),&size)!=0) fail("cannot identify this native executable");
+    path=buffer.data();
+#elif defined(_WIN32)
+    std::vector<wchar_t> buffer(1024);
+    for (;;) { const auto n=GetModuleFileNameW(nullptr,buffer.data(),static_cast<DWORD>(buffer.size()));
+        if (!n) fail("cannot identify this native executable");
+        if (n<buffer.size()) { path=std::wstring(buffer.data(),n);break; }buffer.resize(buffer.size()*2); }
