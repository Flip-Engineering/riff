+void require_output_available(const std::filesystem::path & path) {
+    if (path.empty() || path.filename().empty()) fail("output path must name a new file");
+    std::error_code error;
+    const auto status=std::filesystem::symlink_status(path,error);
+    if (error && error!=std::errc::no_such_file_or_directory) fail("cannot inspect the output path");
+    if (std::filesystem::exists(status)) fail("the output already exists; choose a new checkpoint path");
+    const auto parent=path.parent_path().empty()?std::filesystem::path("."):path.parent_path();
