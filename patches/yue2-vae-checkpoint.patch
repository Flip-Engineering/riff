+struct Metadata {
+    uint64_t frames = 0, latent_dim = 0;
+    Yue2VaeConfig vae;
+    // Stable on-disk storage IDs: native=0,f32=1,f16=2,bf16=3,q8_0=4,q4_0=5,q4_k=6.
+    uint32_t vae_storage = 0, model_storage = 0;
+    uint64_t seed = 0, ode_steps = 0, semantic_frames = 0, context = 0;
+    Yue2OdeMethod ode_method = Yue2OdeMethod::Midpoint;
+    float guidance = 1.0F;
+    bool semantic_truncated = false;
+    Digest payload{}, model{}, decoder{}, model_config{}, decoder_config{};
+    Digest tokenizer{}, generation_config{}, conditioning{}, semantic_codes{}, producer_binary{};
+};
+
+struct Completed {
+    Metadata metadata;
+    std::vector<float> latents;  // [frame, channel], one owned payload allocation
+};
+
+// Writes existing interleaved F32 data directly. A successful no-replace atomic
+// publication occurs only after the complete payload/header have been fsynced.
+// The final path is never truncated, including on failure or a concurrent save.
+void require_output_available(const std::filesystem::path & path);
+void save_completed(const std::filesystem::path & path, Metadata metadata,
+                    const std::vector<float> & latents);
+Completed load_completed(const std::filesystem::path & path);
+void require_decoder(const Metadata & saved, const Yue2VaeConfig & config,
+                     const Digest & model);
+
