+Digest hash_bytes(const void * bytes,size_t size) { Sha256 hash;hash.update(bytes,size);return hash.finish(); }
+Digest hash_file(const std::filesystem::path & path) {
+    auto file=open_read(path);const auto before=descriptor_identity(file.get());
+    Sha256 hash;std::array<uint8_t,65536> block;uint64_t total=0;
+    while (const auto n=std::fread(block.data(),1,block.size(),file.get())) { hash.update(block.data(),n);total+=n; }
+    if (std::ferror(file.get()) || total!=before.bytes || !(descriptor_identity(file.get())==before))
+        fail("could not hash a stable source file");
