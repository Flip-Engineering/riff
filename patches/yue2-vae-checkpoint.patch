+FileIdentity file_identity(const std::filesystem::path & path) {
+#if defined(_WIN32)
+    const HANDLE handle=CreateFileW(path.c_str(),GENERIC_READ,FILE_SHARE_READ|FILE_SHARE_WRITE|FILE_SHARE_DELETE,
