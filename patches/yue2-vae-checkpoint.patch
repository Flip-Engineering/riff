+    Sha256 hash;std::array<uint8_t,16384> swapped;
+    for (size_t start=0;start<latents.size();) {
+        const auto n=std::min<size_t>(swapped.size()/4,latents.size()-start);
+        for (size_t i=0;i<n;++i) if (!std::isfinite(latents[start+i])) fail("latent payload contains a non-finite value");
