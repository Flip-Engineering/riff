+static_assert(sizeof(float) == 4 && std::numeric_limits<float>::is_iec559,
+              "Acoustic checkpoints require IEEE 754 binary32 floats");
+using Header = std::array<uint8_t, kHeaderBytes>;
+using File = std::unique_ptr<FILE, decltype(&std::fclose)>;
+constexpr char kMagic[8] = {'R','I','F','F','Y','A','C','1'};
+
+[[noreturn]] void fail(const char * message) {
+    throw std::runtime_error(std::string("Yue2 acoustic checkpoint: ") + message);
+}
+
+#if defined(__APPLE__) && !defined(RIFF_CHECKPOINT_PORTABLE_SHA)
+#pragma clang diagnostic push
+#pragma clang diagnostic ignored "-Wdeprecated-declarations"
+class Sha256 {
+    CC_SHA256_CTX context_{};
+public:
+    Sha256() { CC_SHA256_Init(&context_); }
+    void update(const void * bytes, size_t size) {
+        const auto * cursor = static_cast<const uint8_t *>(bytes);
+        while (size) {
+            const auto n = static_cast<CC_LONG>(std::min<size_t>(size, std::numeric_limits<CC_LONG>::max()));
+            CC_SHA256_Update(&context_, cursor, n);
+            cursor += n;
+            size -= n;
+        }
+    }
+    Digest finish() { Digest out{}; CC_SHA256_Final(out.data(), &context_); return out; }
+};
+#pragma clang diagnostic pop
+#else
+// Incremental SHA-256, using the same standard compression function as the
+// existing sanotts text-seed implementation. No optional OpenSSL dependency.
+class Sha256 {
+    uint32_t h_[8] = {0x6a09e667U,0xbb67ae85U,0x3c6ef372U,0xa54ff53aU,
+                     0x510e527fU,0x9b05688cU,0x1f83d9abU,0x5be0cd19U};
+    std::array<uint8_t, 64> pending_{};
+    size_t used_ = 0;
+    uint64_t bytes_ = 0;
+    static uint32_t r(uint32_t x, unsigned n) { return (x >> n) | (x << (32 - n)); }
+    void block(const uint8_t * p) {
+        static constexpr uint32_t k[64] = {
+            0x428a2f98,0x71374491,0xb5c0fbcf,0xe9b5dba5,0x3956c25b,0x59f111f1,0x923f82a4,0xab1c5ed5,
+            0xd807aa98,0x12835b01,0x243185be,0x550c7dc3,0x72be5d74,0x80deb1fe,0x9bdc06a7,0xc19bf174,
+            0xe49b69c1,0xefbe4786,0x0fc19dc6,0x240ca1cc,0x2de92c6f,0x4a7484aa,0x5cb0a9dc,0x76f988da,
+            0x983e5152,0xa831c66d,0xb00327c8,0xbf597fc7,0xc6e00bf3,0xd5a79147,0x06ca6351,0x14292967,
+            0x27b70a85,0x2e1b2138,0x4d2c6dfc,0x53380d13,0x650a7354,0x766a0abb,0x81c2c92e,0x92722c85,
+            0xa2bfe8a1,0xa81a664b,0xc24b8b70,0xc76c51a3,0xd192e819,0xd6990624,0xf40e3585,0x106aa070,
+            0x19a4c116,0x1e376c08,0x2748774c,0x34b0bcb5,0x391c0cb3,0x4ed8aa4a,0x5b9cca4f,0x682e6ff3,
+            0x748f82ee,0x78a5636f,0x84c87814,0x8cc70208,0x90befffa,0xa4506ceb,0xbef9a3f7,0xc67178f2};
+        uint32_t w[64];
+        for (size_t i=0; i<16; ++i) w[i] = (uint32_t(p[i*4])<<24)|(uint32_t(p[i*4+1])<<16)|
+                                                (uint32_t(p[i*4+2])<<8)|p[i*4+3];
+        for (size_t i=16; i<64; ++i) w[i] = w[i-16] + (r(w[i-15],7)^r(w[i-15],18)^(w[i-15]>>3)) +
+                                                     w[i-7] + (r(w[i-2],17)^r(w[i-2],19)^(w[i-2]>>10));
+        uint32_t a=h_[0],b=h_[1],c=h_[2],d=h_[3],e=h_[4],f=h_[5],g=h_[6],h=h_[7];
+        for (size_t i=0; i<64; ++i) {
+            const auto t1=h+(r(e,6)^r(e,11)^r(e,25))+((e&f)^(~e&g))+k[i]+w[i];
+            const auto t2=(r(a,2)^r(a,13)^r(a,22))+((a&b)^(a&c)^(b&c));
+            h=g;g=f;f=e;e=d+t1;d=c;c=b;b=a;a=t1+t2;
+        }
+        h_[0]+=a;h_[1]+=b;h_[2]+=c;h_[3]+=d;h_[4]+=e;h_[5]+=f;h_[6]+=g;h_[7]+=h;
+    }
+public:
+    void update(const void * bytes, size_t size) {
+        if (size > std::numeric_limits<uint64_t>::max()/8 - bytes_) fail("hash input is too large");
+        bytes_ += size;
+        auto * p = static_cast<const uint8_t *>(bytes);
+        while (size) {
+            const auto n=std::min(size,64-used_);
+            std::memcpy(pending_.data()+used_,p,n); used_+=n;p+=n;size-=n;
+            if (used_==64) { block(pending_.data()); used_=0; }
+        }
+    }
+    Digest finish() {
+        const uint64_t bits=bytes_*8;
+        pending_[used_++]=0x80;
+        if (used_>56) { std::fill(pending_.begin()+used_,pending_.end(),0);block(pending_.data());used_=0; }
+        std::fill(pending_.begin()+used_,pending_.end(),0);
+        for (unsigned i=0;i<8;++i) pending_[63-i]=static_cast<uint8_t>(bits>>(8*i));
+        block(pending_.data());
+        Digest out{};
+        for (size_t i=0;i<8;++i) for(unsigned j=0;j<4;++j) out[i*4+j]=static_cast<uint8_t>(h_[i]>>(24-8*j));
+        return out;
+    }
+};
+#endif
+
+void put(uint8_t * p, uint64_t value, size_t bytes) {
+    for (size_t i = 0; i < bytes; ++i) p[i] = static_cast<uint8_t>(value >> (8*i));
+}
+uint64_t get(const uint8_t * p, size_t bytes) {
+    uint64_t value = 0;
+    for (size_t i = 0; i < bytes; ++i) value |= uint64_t(p[i]) << (8*i);
+    return value;
+}
+bool little_endian() { const uint32_t value = 1; return *reinterpret_cast<const uint8_t *>(&value) == 1; }
+bool empty(const Digest & hash) { return std::all_of(hash.begin(), hash.end(), [](auto v) { return v == 0; }); }
+uint64_t payload_size(const Metadata & m) {
+    if (!m.frames || !m.latent_dim || m.frames > uint64_t(INT64_MAX) || m.latent_dim > uint64_t(INT64_MAX) ||
+        m.frames > (std::numeric_limits<uint64_t>::max()-kHeaderBytes)/4/m.latent_dim)
+        fail("invalid or overflowing latent shape");
+    const uint64_t bytes = m.frames * m.latent_dim * 4;
+    if (bytes > std::numeric_limits<size_t>::max() || m.frames > uint64_t(INT64_MAX)/m.latent_dim)
+        fail("latent shape is too large for this runtime");
+    return bytes;
+}
+void validate(const Metadata & m) {
+    (void) payload_size(m);
+    const auto & v = m.vae;
+    if (v.sample_rate <= 0 || v.channels <= 0 || v.channels > INT32_MAX || v.latent_dim <= 0 ||
+        uint64_t(v.latent_dim) != m.latent_dim || v.encoder_latent_dim <= 0 || v.downsampling_ratio <= 0 ||
+        v.decode_core_frames <= 0 || v.decode_halo_frames < 0 || m.vae_storage > 6 || m.model_storage > 6 ||
+        m.seed >= (uint64_t(1)<<63) || !m.ode_steps || m.ode_steps > uint64_t(INT64_MAX) ||
+        !m.context || m.context > uint64_t(INT64_MAX) || m.semantic_frames != m.frames ||
+        !std::isfinite(m.guidance) || m.guidance < 0 || m.guidance > 20 ||
+        (m.ode_method != Yue2OdeMethod::Midpoint && m.ode_method != Yue2OdeMethod::AdamsBashforth2))
+        fail("invalid completed acoustic metadata");
+    if (m.frames > uint64_t(INT64_MAX)/uint64_t(v.downsampling_ratio) ||
+        m.frames*uint64_t(v.downsampling_ratio) <= 64 ||
+        m.frames*uint64_t(v.downsampling_ratio)-64 > std::numeric_limits<size_t>::max()/sizeof(float)/uint64_t(v.channels))
+        fail("decoded audio shape overflows this runtime");
+    for (const auto * digest : {&m.model,&m.decoder,&m.model_config,&m.decoder_config,&m.tokenizer,
+                               &m.generation_config,&m.conditioning,&m.semantic_codes,&m.producer_binary})
+        if (empty(*digest)) fail("missing source provenance digest");
+}
+Header encode(const Metadata & m) {
+    validate(m);
+    Header h{};
+    std::copy(std::begin(kMagic),std::end(kMagic),h.begin());
+    put(h.data()+8,1,4); put(h.data()+12,kHeaderBytes,4);
+    put(h.data()+16,1,4); put(h.data()+20,1,4); put(h.data()+24,1,4); // F32LE, frame-major, complete
+    put(h.data()+28,m.semantic_truncated?1:0,4);
+    const uint64_t fields[] = {m.frames,m.latent_dim,payload_size(m),uint64_t(m.vae.sample_rate),
+        uint64_t(m.vae.channels),uint64_t(m.vae.downsampling_ratio),uint64_t(m.vae.decode_core_frames),
+        uint64_t(m.vae.decode_halo_frames),uint64_t(m.vae.encoder_latent_dim)};
+    for (size_t i=0;i<9;++i) put(h.data()+32+i*8,fields[i],8);
+    put(h.data()+104,m.vae_storage,4);put(h.data()+108,m.model_storage,4);
+    put(h.data()+112,m.seed,8);put(h.data()+120,m.ode_steps,8);
+    put(h.data()+128,m.ode_method==Yue2OdeMethod::Midpoint?1:2,4);put(h.data()+132,kDecoderContract,4);
+    put(h.data()+136,m.semantic_frames,8);put(h.data()+144,m.context,8);
+    uint32_t guidance;std::memcpy(&guidance,&m.guidance,4);put(h.data()+152,guidance,4);
+    size_t offset=160;
+    for (const auto * digest : {&m.payload,&m.model,&m.decoder,&m.model_config,&m.decoder_config,
+                               &m.tokenizer,&m.generation_config,&m.conditioning,&m.semantic_codes,&m.producer_binary}) {
+        std::copy(digest->begin(),digest->end(),h.begin()+offset);offset+=32;
+    }
+    const auto digest=hash_bytes(h.data(),480);std::copy(digest.begin(),digest.end(),h.begin()+480);
+    return h;
+}
+Metadata decode(const Header & h) {
+    const auto digest=hash_bytes(h.data(),480);
+    if (!std::equal(std::begin(kMagic),std::end(kMagic),h.begin()) ||
+        !std::equal(digest.begin(),digest.end(),h.begin()+480)) fail("invalid header or header digest");
+    if (get(h.data()+8,4)!=1 || get(h.data()+12,4)!=kHeaderBytes || get(h.data()+16,4)!=1 ||
+        get(h.data()+20,4)!=1 || get(h.data()+24,4)!=1 || get(h.data()+28,4)>1 ||
+        get(h.data()+132,4)!=kDecoderContract || get(h.data()+156,4)!=0)
+        fail("unsupported format, dtype, layout, decoder contract, or incomplete state");
+    // Check all serialized signed dimensions before narrowing to runtime types.
+    for (size_t offset=32;offset<=96;offset+=8)
+        if (get(h.data()+offset,8)>uint64_t(INT64_MAX)) fail("dimension exceeds signed runtime range");
+    if (get(h.data()+56,8)>uint64_t(INT32_MAX) || get(h.data()+64,8)>uint64_t(INT32_MAX))
+        fail("audio rate or channel count exceeds runtime range");
+    Metadata m;
+    m.frames=get(h.data()+32,8);m.latent_dim=get(h.data()+40,8);
+    m.vae.sample_rate=static_cast<int>(get(h.data()+56,8));m.vae.channels=get(h.data()+64,8);
+    m.vae.latent_dim=static_cast<int64_t>(m.latent_dim);m.vae.downsampling_ratio=get(h.data()+72,8);
+    m.vae.decode_core_frames=get(h.data()+80,8);m.vae.decode_halo_frames=get(h.data()+88,8);
+    m.vae.encoder_latent_dim=get(h.data()+96,8);
+    m.vae_storage=get(h.data()+104,4);m.model_storage=get(h.data()+108,4);
+    m.seed=get(h.data()+112,8);m.ode_steps=get(h.data()+120,8);
+    const auto method=get(h.data()+128,4);
+    if (method!=1 && method!=2) fail("unknown acoustic solver");
+    m.ode_method=method==1?Yue2OdeMethod::Midpoint:Yue2OdeMethod::AdamsBashforth2;
+    m.semantic_frames=get(h.data()+136,8);m.context=get(h.data()+144,8);
+    const auto guidance=static_cast<uint32_t>(get(h.data()+152,4));std::memcpy(&m.guidance,&guidance,4);
+    m.semantic_truncated=get(h.data()+28,4)!=0;
+    size_t offset=160;
+    for (auto * value : {&m.payload,&m.model,&m.decoder,&m.model_config,&m.decoder_config,
+                        &m.tokenizer,&m.generation_config,&m.conditioning,&m.semantic_codes,&m.producer_binary}) {
+        std::copy_n(h.begin()+offset,32,value->begin());offset+=32;
+    }
+    validate(m);
+    if (get(h.data()+48,8)!=payload_size(m)) fail("payload byte count does not match the shape");
+    return m;
+}
+
+#if !defined(_WIN32)
+FileIdentity identity(const struct stat & s) {
+    if (!S_ISREG(s.st_mode) || s.st_size < 0) fail("input must be a regular file");
+#if defined(__APPLE__)
+#if !defined(_POSIX_C_SOURCE) || defined(_DARWIN_C_SOURCE)
+    const auto modified=s.st_mtimespec,changed=s.st_ctimespec;
+#else
+    // audio.cpp compiles with POSIX_C_SOURCE, which exposes Darwin's nanosecond
+    // fields separately instead of the non-POSIX timespec aliases.
+    const timespec modified{s.st_mtime,s.st_mtimensec},changed{s.st_ctime,s.st_ctimensec};
+#endif
+#else
+    const auto modified=s.st_mtim,changed=s.st_ctim;
+#endif
+    return {uint64_t(s.st_size),uint64_t(s.st_dev),uint64_t(s.st_ino),
+            uint64_t(modified.tv_sec)*1000000000+uint64_t(modified.tv_nsec),
+            uint64_t(changed.tv_sec)*1000000000+uint64_t(changed.tv_nsec)};
+}
+FileIdentity descriptor_identity(FILE * file) {
+    struct stat s{};if (::fstat(::fileno(file),&s)!=0) fail("cannot inspect the open input");return identity(s);
+}
+#else
+FileIdentity handle_identity(HANDLE handle) {
+    BY_HANDLE_FILE_INFORMATION s{};
+    if (!GetFileInformationByHandle(handle,&s) || (s.dwFileAttributes&FILE_ATTRIBUTE_DIRECTORY))
+        fail("input must be a readable regular file");
+    return {(uint64_t(s.nFileSizeHigh)<<32)|s.nFileSizeLow,s.dwVolumeSerialNumber,
+            (uint64_t(s.nFileIndexHigh)<<32)|s.nFileIndexLow,
+            (uint64_t(s.ftLastWriteTime.dwHighDateTime)<<32)|s.ftLastWriteTime.dwLowDateTime,
+            (uint64_t(s.ftCreationTime.dwHighDateTime)<<32)|s.ftCreationTime.dwLowDateTime};
+}
+FileIdentity descriptor_identity(FILE * file) { return handle_identity(reinterpret_cast<HANDLE>(_get_osfhandle(_fileno(file)))); }
+#endif
+File open_read(const std::filesystem::path & path) {
+#if defined(_WIN32)
+    File file(_wfopen(path.c_str(),L"rb"),&std::fclose);
+#else
+    // Check the opened descriptor, without waiting indefinitely on a FIFO or
+    // device presented as a checkpoint. O_NONBLOCK has no effect on regular files.
+    const int fd=::open(path.c_str(),O_RDONLY|O_NONBLOCK|O_CLOEXEC);
+    File file(fd>=0?::fdopen(fd,"rb"):nullptr,&std::fclose);
+    if (fd>=0 && !file) ::close(fd);
+#endif
+    if (!file) fail("cannot open the input file");
+    (void) descriptor_identity(file.get());
+    return file;
+}
+void write(FILE * f, const void * bytes, size_t n) {
+    if (std::fwrite(bytes,1,n,f)!=n) fail("could not write the complete checkpoint");
+}
+void sync(FILE * f) {
+    if (std::fflush(f)!=0) fail("could not flush the checkpoint");
+#if defined(_WIN32)
+    if (_commit(_fileno(f))!=0) fail("could not sync the checkpoint");
+#else
+    if (::fsync(::fileno(f))!=0) fail("could not sync the checkpoint");
+#endif
+}
+void sync_parent(const std::filesystem::path & path) {
+#if !defined(_WIN32)
+    const auto parent=path.parent_path().empty()?std::filesystem::path("."):path.parent_path();
+    const int fd=::open(parent.c_str(),O_RDONLY|O_DIRECTORY|O_CLOEXEC);
+    if (fd<0) fail("could not open checkpoint directory for sync");
+    const int result=::fsync(fd);const int saved=errno;::close(fd);errno=saved;
+    if (result!=0) fail("checkpoint is complete but directory sync failed");
+#else
+    (void) path; // MoveFileExW(MOVEFILE_WRITE_THROUGH) below owns rename durability.
+#endif
+}
+struct Pending {
+    std::filesystem::path path;
+    File file{nullptr,&std::fclose};
+    explicit Pending(const std::filesystem::path & target) {
+        static std::atomic<uint64_t> sequence{0};
